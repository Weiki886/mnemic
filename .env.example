# 占位示例，不含真实凭据。复制为 .env 后填写。

# PostgreSQL（与 docker-compose.yml 对齐）
DATABASE_URL=postgres://mnemic:mnemic@localhost:5432/mnemic

# 服务端 Bearer Token（#20 最小鉴权）
MNEMIC_AUTH_TOKEN=change-me

# 模型 Provider Key（spike 与后续 Issue 使用；不提交真实值）
DEEPSEEK_API_KEY=
# DeepSeek 模型 ID（须与官方 API 标识完全一致，如 deepseek-chat）
DEEPSEEK_MODEL=deepseek-chat
DASHSCOPE_API_KEY=
