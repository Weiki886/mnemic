# 占位示例，不含真实凭据。复制为 .env 后填写。

# 本地 PostgreSQL（容器开发入口 docker-compose.dev.yml；完整部署另用 deploy/.env.example）
DATABASE_URL=postgres://mnemic:mnemic@localhost:5432/mnemic

# 服务端单用户 Bearer Token（必填；32–256 位 ASCII；生成：openssl rand -hex 32）
# 空值/旧 change-me 会拒绝启动。CLI 需在 shell 中另行 export 同一个值。
MNEMIC_AUTH_TOKEN=

# CLI 服务地址（CLI 从 shell 环境读取；默认不加载 .env，也不读取本地模型 Key）
# MNEMIC_SERVER_URL=http://localhost:3000

# 监听地址/端口：默认 127.0.0.1:3000；
# 部署到容器/公网须显式 HOST=0.0.0.0
# HOST=0.0.0.0
# PORT=3000

# 显式开启聊天写回/检索的元数据 JSONL 轨迹；默认关闭，不捕获 prompt/回答正文。
# 开启时应用使用 debug 日志级别，详见 docs/debug-traces.md。
MNEMIC_DEBUG=0
# 正文捕获另须显式开启；可能包含业务秘密/PII，仅用于受控排障
MNEMIC_DEBUG_CONTENT=0

# 模型 Provider Key（spike 与后续 Issue 使用；不提交真实值）
DEEPSEEK_API_KEY=
# DeepSeek 模型 ID（须与官方 API 标识完全一致，如 deepseek-chat）
DEEPSEEK_MODEL=deepseek-chat
DASHSCOPE_API_KEY=

# Provider Key 加密主密钥（#14；64 位 hex = 32 字节，生成：openssl rand -hex 32）
MNEMIC_MASTER_KEY=
# embedding 维度（部署级配置，须与库中向量列一致；更换走 REEMBED 流程）
MNEMIC_EMBEDDING_DIMENSIONS=1024

# CORS 允许的源（#8 Web 记忆中心跨源调 API；默认 http://localhost:5173）
# CORS_ORIGIN=http://localhost:5173
