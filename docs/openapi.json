  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": ["System"],
        "summary": "Check HTTP service liveness",
        "description": "Public liveness only; this does not prove database, model or deployment readiness. Query parameters are ignored.",
        "security": [],
        "responses": {
          "200": {
            "description": "HTTP process is responding.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string",
                  "description": "Server request identifier, also present in problem bodies."
                },
                "required": true
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" },
                "example": { "status": "ok" }
              }
            }
          }
        }
      },
      "head": {
        "operationId": "headHealth",
        "tags": ["System"],
        "summary": "Check liveness without a response body",
        "description": "Same public liveness check as GET; the response body is empty.",
        "security": [],
        "responses": {
          "200": {
            "description": "HTTP process is responding; no response body.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string",
                  "description": "Server request identifier, also present in problem bodies."
                },
                "required": true
              }
            }
          }
        }
      }
    },
    "/v1/config/flags": {
      "get": {
        "operationId": "getFeatureFlags",
        "tags": ["Configuration"],
        "summary": "Read persisted feature flag configuration",
        "description": "Global operator scope. No query parameters accepted. Returns persisted flags rather than effective per-operation overrides; no model invocation. Cache-Control: no-store.",
        "responses": {
          "200": {
            "description": "Strict persisted snapshot; historical or unsupported true values may be read for operator repair.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string",
                  "description": "Server request identifier, also present in problem bodies."
                },
                "required": true
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FeatureFlagSnapshot" },
                "example": {
                  "schema_version": 1,
                  "revision": 0,
                  "flags": {
                    "retrieval_vector": true,
                    "retrieval_keyword": true,
                    "retrieval_entity": false,
                    "retrieval_time": false,
                    "memory_gate": true,
                    "decay": false,
                    "reranker": false,
                    "authority_resolution": true,
                    "read_time_resolution": false,
                    "read_time_reinforcement": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or query parameters.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string",
                  "description": "Server request identifier, also present in problem bodies."
                },
                "required": true
              }
            },
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "401": {
            "description": "Bearer authentication is required before parsing JSON or accessing data.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string",
                  "description": "Server request identifier, also present in problem bodies."
                },
                "required": true
              }
            },
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "429": {
            "description": "IP or authenticated-token request budget exhausted. No automatic retry.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string",
                  "description": "Server request identifier, also present in problem bodies."
                },
                "required": true
              },
              "Retry-After": {
                "schema": {
                  "type": "string",
                  "pattern": "^[1-9]\\d*$",
                  "description": "Minimum suggested wait in seconds; competing traffic can consume replenished capacity."
                },
                "required": true
              }
            },
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "500": {
            "description": "Database or server failure. Internal payloads are not returned.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string",
                  "description": "Server request identifier, also present in problem bodies."
                },
                "required": true
              }
            },
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "replaceFeatureFlags",
        "tags": ["Configuration"],
        "summary": "Replace all feature flags with revision checking",
        "description": "JSON-only full replacement, no query parameters. Audit and update are atomic; unchanged flags do not increase revision or write an audit. Unsupported true flags (retrieval_entity, retrieval_time, decay, reranker, read_time_resolution) return 400 before database access even though their syntactic type is boolean. Cache-Control: no-store.",
        "requestBody": {
          "required": true,
          "description": "Use the current revision from GET. This offline example assumes a fresh revision=0 snapshot; otherwise refresh and deliberately choose a new full replacement.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FeatureFlagUpdate" },
              "example": {
                "expected_revision": 0,
                "flags": {
                  "retrieval_vector": true,
                  "retrieval_keyword": true,
                  "retrieval_entity": false,
                  "retrieval_time": false,
                  "memory_gate": false,
                  "decay": false,
                  "reranker": false,
                  "authority_resolution": true,
                  "read_time_resolution": false,
                  "read_time_reinforcement": false
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated or unchanged snapshot; no model invocation.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string",
                  "description": "Server request identifier, also present in problem bodies."
                },
                "required": true
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FeatureFlagUpdateResult" }
              }
            }
          },
          "400": {
            "description": "Invalid request or query parameters.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string",
                  "description": "Server request identifier, also present in problem bodies."
                },
                "required": true
              }
            },
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "401": {
            "description": "Bearer authentication is required before parsing JSON or accessing data.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string",
                  "description": "Server request identifier, also present in problem bodies."
                },
                "required": true
              }
            },
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "409": {
            "description": "Revision mismatch or exhausted revision. Read current configuration before a deliberate retry.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string",
                  "description": "Server request identifier, also present in problem bodies."
                },
                "required": true
              }
            },
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "415": {
            "description": "Content-Type must be application/json, optionally with charset.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string",
                  "description": "Server request identifier, also present in problem bodies."
                },
                "required": true
              }
            },
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "429": {
            "description": "IP or authenticated-token request budget exhausted. No automatic retry.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string",
                  "description": "Server request identifier, also present in problem bodies."
                },
                "required": true
              },
              "Retry-After": {
                "schema": {
                  "type": "string",
                  "pattern": "^[1-9]\\d*$",
                  "description": "Minimum suggested wait in seconds; competing traffic can consume replenished capacity."
                },
                "required": true
              }
            },
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "500": {
            "description": "Database or server failure. Internal payloads are not returned.",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string",
                  "description": "Server request identifier, also present in problem bodies."
                },
                "required": true
              }
            },
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        }
      }
    }
  }
