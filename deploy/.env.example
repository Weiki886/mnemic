# 复制为 deploy/.env（不入 Git）；不要用开发用的根 .env 启动生产栈。
MNEMIC_DOMAIN=
# 三项分别独立生成：openssl rand -hex 32；迁移已有 DB 时 MASTER_KEY 必须沿用原值！
POSTGRES_PASSWORD=
MNEMIC_AUTH_TOKEN=
MNEMIC_MASTER_KEY=
# 部署版本标记建议为 git commit SHA，便于保留旧镜像；不要使用同一 tag 覆盖旧版本。
MNEMIC_IMAGE_TAG=local
# 可选结构化元数据轨迹，0关闭/1开启；当前不记录 prompt/回答正文。
MNEMIC_DEBUG=0
# 正文捕获另须显式开启；可能包含业务秘密/PII，仅用于受控排障
MNEMIC_DEBUG_CONTENT=0
# 可选的 token 估价配置，留空表示价格未知；格式见 docs/usage-reports.md。
# MNEMIC_USAGE_PRICES_JSON={"currency":"USD","rates":[]}
# 以下只用于环回冒烟；公网默认 0.0.0.0:80/443。
# MNEMIC_BIND_IP=127.0.0.1
# MNEMIC_HTTP_PORT=58080
# MNEMIC_HTTPS_PORT=58443
